[globcfg]
base_address = 0
data_width = 32
address_width = 12
register_reset = sync_neg
address_increment = none
address_alignment = data_width
force_name_case = none
regmap_path = regs.json

[v_module]
path = corsair_example_regs.v
read_filler = 0
interface = axil
generator = Verilog

[sv_pkg]
path = corsair_example_regs_pkg.sv
prefix = CSR
generator = SystemVerilogPackage

[md_doc]
path = corsair_example_regs.md
title = Corsair example register map
print_images = False
print_conventions = True
generator = Markdown
